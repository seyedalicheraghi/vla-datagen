{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "drone-owner",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ],
    "allow": [
      "Bash(scripts/drone_scene/realism/run_probe.sh *)",
      "Bash(scripts/drone_scene/realism/run_tests.sh)",
      "Bash(scripts/drone_scene/realism/run_tests.sh *)",
      "Bash(git worktree *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git rev-parse *)",
      "Bash(nvidia-smi *)",
      "Bash(pgrep *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py"
          }
        ]
      }
    ]
  }
}
