<?xml version="1.0"?>
<robot name="forklift">

  <!-- ================================================================
       Materials
  ================================================================ -->
  <material name="yellow">
    <color rgba="1.0 0.8 0.0 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <!-- ================================================================
       Base chassis  —  visual uses the 48-forklift 3-D mesh
       Mesh is in Cinema 4D centimetres (Y-up), so we apply:
         scale 0.004  → roughly 1 m wide / 2 m tall at the chosen unit
         rpy "π/2  0  π" → rotate Y-up to Z-up, then flip 180° so that
                           the mesh's fork/mast side faces URDF +X
         xyz "0  0  -0.6" → put the mesh's ground (Y=0) at z=-0.6 in
                            base_link frame (chassis centre is 0.6 m
                            above world ground after the height fix)
       Collision keeps the cheap primitive box for physics performance.
  ================================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.6" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="../48-forklift/Forklift.obj"
              scale="0.004 0.004 0.004"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 1.0 0.6"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="800.0"/>
      <inertia ixx="100.0" ixy="0" ixz="0" iyy="200.0" iyz="0" izz="200.0"/>
    </inertial>
  </link>

  <!-- ================================================================
       Rear left drive wheel — visual suppressed (covered by body mesh)
  ================================================================ -->
  <link name="rear_left_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.9"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.6 0.575 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Rear right drive wheel — visual suppressed (covered by body mesh)
  ================================================================ -->
  <link name="rear_right_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.9"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.6 -0.575 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Front left caster wheel — visual suppressed (covered by body mesh)
  ================================================================ -->
  <link name="front_left_caster">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="front_left_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_caster"/>
    <origin xyz="0.7 0.4 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Front right caster wheel — visual suppressed (covered by body mesh)
  ================================================================ -->
  <link name="front_right_caster">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="front_right_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_caster"/>
    <origin xyz="0.7 -0.4 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Mast — visual suppressed (mast is part of the body mesh)
  ================================================================ -->
  <link name="mast">
    <collision>
      <origin xyz="0 0 0.9" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.8 1.8"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="2.0"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="0.85 0 -0.3" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       Fork carriage — keeps its visual so fork raising is animated
  ================================================================ -->
  <link name="fork_carriage">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.9 0.3"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.9 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="fork_lift_joint" type="prismatic">
    <parent link="mast"/>
    <child link="fork_carriage"/>
    <origin xyz="0.05 0 0.150" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.5" effort="5000.0" velocity="2.0"/>
  </joint>

  <!-- ================================================================
       Left fork tine — keeps its visual so fork raising is animated
  ================================================================ -->
  <link name="fork_left">
    <visual>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="fork_left_joint" type="fixed">
    <parent link="fork_carriage"/>
    <child link="fork_left"/>
    <origin xyz="0 0.25 -0.125" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       Right fork tine — keeps its visual so fork raising is animated
  ================================================================ -->
  <link name="fork_right">
    <visual>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="fork_right_joint" type="fixed">
    <parent link="fork_carriage"/>
    <child link="fork_right"/>
    <origin xyz="0 -0.25 -0.125" rpy="0 0 0"/>
  </joint>

</robot>
