<?xml version="1.0"?>
<robot name="forklift">

  <!-- ================================================================
       Materials
  ================================================================ -->
  <material name="yellow">
    <color rgba="1.0 0.8 0.0 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <!-- ================================================================
       Base chassis
  ================================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 1.0 0.6"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 1.0 0.6"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="800.0"/>
      <inertia ixx="100.0" ixy="0" ixz="0" iyy="200.0" iyz="0" izz="200.0"/>
    </inertial>
  </link>

  <!-- ================================================================
       Rear left drive wheel
  ================================================================ -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.9"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.6 0.575 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Rear right drive wheel
  ================================================================ -->
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.9"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.6 -0.575 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Front left caster wheel (non-driven)
  ================================================================ -->
  <link name="front_left_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="front_left_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_caster"/>
    <origin xyz="0.7 0.4 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Front right caster wheel (non-driven)
  ================================================================ -->
  <link name="front_right_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="front_right_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_caster"/>
    <origin xyz="0.7 -0.4 -0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================================================================
       Mast (vertical column the fork slides along)
  ================================================================ -->
  <link name="mast">
    <visual>
      <!-- Taller mast (1.8 m) centred at 0.9 m above mast origin -->
      <origin xyz="0 0 0.9" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.8 1.8"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.9" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.8 1.8"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="2.0"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <!-- Bottom of chassis → fork tines reach ground level at joint=0 -->
    <origin xyz="0.85 0 -0.3" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       Fork carriage — slides up/down the mast (prismatic joint)
  ================================================================ -->
  <link name="fork_carriage">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.9 0.3"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.9 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="fork_lift_joint" type="prismatic">
    <parent link="mast"/>
    <child link="fork_carriage"/>
    <!-- Carriage origin at z=0.175 above mast base (mast base is at world z=0).
         Fork tines hang 0.125 below carriage, tine half-height 0.025 m →
         tine bottom at world z = 0.175 - 0.125 - 0.025 = 0.025 m (near ground). -->
    <origin xyz="0.05 0 0.175" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.5" effort="5000.0" velocity="0.5"/>
  </joint>

  <!-- ================================================================
       Left fork tine
  ================================================================ -->
  <link name="fork_left">
    <visual>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="fork_left_joint" type="fixed">
    <parent link="fork_carriage"/>
    <child link="fork_left"/>
    <origin xyz="0 0.25 -0.125" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       Right fork tine
  ================================================================ -->
  <link name="fork_right">
    <visual>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.6 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 0.15 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="fork_right_joint" type="fixed">
    <parent link="fork_carriage"/>
    <child link="fork_right"/>
    <origin xyz="0 -0.25 -0.125" rpy="0 0 0"/>
  </joint>

</robot>
